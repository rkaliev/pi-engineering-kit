{
  "name": "pi-engineering-kit",
  "version": "0.2.0",
  "description": "Skills, prompt templates and guard/verify extensions for a disciplined universal coding agent on pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkaliev/pi-engineering-kit.git"
  },
  "homepage": "https://github.com/rkaliev/pi-engineering-kit#readme",
  "bugs": {
    "url": "https://github.com/rkaliev/pi-engineering-kit/issues"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "code-review",
    "payments",
    "legacy-code"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./extensions/bootstrap.ts",
      "./extensions/guard.ts",
      "./extensions/verify.ts",
      "./extensions/models.ts",
      "./extensions/init.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "22.18.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
