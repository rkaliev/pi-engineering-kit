# Copy to .env. Never commit .env. An empty value means "use the default".

# Local database (docker compose). POSTGRES_MAJOR: current supported major from postgresql.org.
POSTGRES_MAJOR=
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# API (apps/api/src/config.ts owns these and their defaults)
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Per-connection limits applied by the pool (milliseconds)
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Pool size
DB_POOL_MAX=10
# How long a SIGTERM drain may take before the process exits non-zero
SHUTDOWN_TIMEOUT_MS=10000
