{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "db:up": "POSTGRES_MAJOR=$(cat .postgres-version) docker compose up -d --wait postgres",
    "db:down": "POSTGRES_MAJOR=$(cat .postgres-version) docker compose down"
  },
  "prettier": "@repo/prettier-config"
}
