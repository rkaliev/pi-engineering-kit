datasource db {
  provider = "postgresql"
}

// Kysely types only; there is no Prisma Client in this repo.
generator kysely {
  provider = "prisma-kysely"
  output   = "../src/generated"
  fileName = "types.ts"
}

// One small model so generate and migrate deploy have something to do. Replace it with the product's.
model Account {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
